# Vantelyx CLM — environment example (copy to .env)
# MySQL (used by docker-compose and the .NET API in MySQL mode)
MYSQL_DATABASE=vantelyx_clm
MYSQL_USER=vantelyx_user
MYSQL_PASSWORD=vantelyx_password
MYSQL_ROOT_PASSWORD=vantelyx_root_password

# API
API_PORT=5058
WEB_PORT=9701

# Frontend adapter (leave blank for frontend-only/localStorage demo mode)
VITE_API_BASE_URL=http://localhost:5058
